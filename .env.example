# Interactive model keys belong in Nova settings.
# Background worker configuration uses a separate .env.worker; see .env.worker.example.
# Enables command requests in the local agent. Every command requires UI approval and Docker isolation.
NOVA_ENABLE_TERMINAL=0
# Optional: folder in which agent files and shell commands operate.
# NOVA_WORKSPACE_DIR=/absolute/path/to/a/project
# Optional: durable notes and task logs, separate from working files.
# NOVA_STATE_DIR=/absolute/path/to/nova-state

# Shell commands always use a constrained Docker sandbox (no host fallback).
NOVA_SANDBOX_IMAGE=node:22-bookworm-slim

# Optional localhost messaging bridge. Set a long random private token to enable.
# NOVA_GATEWAY_TOKEN=
# NOVA_GATEWAY_TOOLS=list_files,read_file,search_memory,fetch_url,calculate

# Permission ceiling: read, workspace, operator. Unknown values deny tools.
NOVA_PERMISSION_LEVEL=operator

# Optional same-provider fallback model.
# NOVA_FALLBACK_MODEL=another-model-id
# Optional vault encryption key (base64-encoded 32 random bytes).
# Keep consistent for the web app and worker, or preserve the generated .nova/vault.key.
# NOVA_VAULT_KEY=
# Optional authenticated background runner endpoint (at least 32 random characters).
# NOVA_RUNNER_TOKEN=
