# Copy to .env.worker. Never commit that file.
# Works with any provider using OpenAI-compatible or Anthropic Messages APIs.
NOVA_MODEL_BASE=http://localhost:11434/v1
NOVA_MODEL=your-installed-model
NOVA_MODEL_KEY=
NOVA_MODEL_PROTOCOL=openai
NOVA_ENABLE_TERMINAL=0
# Match the web server paths if you override them in .env.local.
# NOVA_STATE_DIR=/absolute/path/to/nova-state
# NOVA_WORKSPACE_DIR=/absolute/path/to/nova-workspace
# Optional outbound gateway. Enable notifications separately for each job.
# NOVA_NOTIFY_WEBHOOK=https://your-approved-destination.com/webhook
# NOVA_NOTIFY_TOKEN=

# Shell commands always use a constrained Docker sandbox (no host fallback).
NOVA_SANDBOX_IMAGE=node:22-bookworm-slim

# Permission ceiling: read, workspace, operator. Unknown values deny tools.
NOVA_PERMISSION_LEVEL=operator

# Unified gateway, loopback only. Tokens must be at least 24 characters.
# NOVA_GATEWAY_TOKEN=replace-with-a-long-random-token
# NOVA_GATEWAY_PORT=4318
# NOVA_GATEWAY_LINKS={"telegram:123456":"personal","discord:trusted-user":"personal","cli:me":"personal"}
# NOVA_TELEGRAM_TOKEN=
# NOVA_GATEWAY_TOOLS=list_files,read_file,search_memory,fetch_url,calculate,delegate
# Optional speech transcription for CLI --voice and Telegram voice memos.
# NOVA_STT_BASE=https://api.openai.com/v1
# NOVA_STT_MODEL=whisper-1
# NOVA_STT_KEY=
# Optional isolated automation adapters. Same values in .env.local for browser ingress.
# NOVA_BROWSER_ADAPTER=http://127.0.0.1:4320
# NOVA_DESKTOP_ADAPTER=http://127.0.0.1:4320
# NOVA_AUTOMATION_TOKEN=replace-with-a-long-random-token
# NOVA_BROWSER_DOMAINS=docs.python.org,developer.mozilla.org

# Optional same-provider fallback model.
# NOVA_FALLBACK_MODEL=another-model-id
# Optional vault encryption key (base64-encoded 32 random bytes).
# Keep consistent for the web app and worker, or preserve the generated .nova/vault.key.
# NOVA_VAULT_KEY=
# Optional authenticated background runner endpoint (at least 32 random characters).
# NOVA_RUNNER_TOKEN=

# Optional local / cloud routing for direct CLI and worker inference.
# NOVA_ROUTER_FILE=deploy/model-router.example.json

# Native platform adapters (leave empty to disable). Sender IDs must be linked above.
# NOVA_DISCORD_TOKEN=
# NOVA_DISCORD_CHANNELS=
# NOVA_SLACK_APP_TOKEN=
# NOVA_SLACK_BOT_TOKEN=
# NOVA_WHATSAPP_TOKEN=
# NOVA_WHATSAPP_PHONE_ID=
# NOVA_WHATSAPP_APP_SECRET=
# NOVA_WHATSAPP_VERIFY_TOKEN=
# NOVA_META_API_VERSION=
# NOVA_SIGNAL_URL=http://127.0.0.1:8080
# NOVA_SIGNAL_ACCOUNT=
