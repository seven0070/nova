# Copy to .env.backend on the backend host. Never commit real keys.
NOVA_BACKEND_HOST=127.0.0.1
NOVA_BACKEND_PORT=4319
NOVA_BACKEND_STATE_DIR=.nova-backend
# Generate a unique token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOVA_BACKEND_TOKEN=replace-with-at-least-32-random-characters
# Optional separate devices; remove a token and restart to revoke that device.
# NOVA_BACKEND_TOKENS={"macbook":"random-token-at-least-32-characters","laptop":"different-random-token-at-least-32-characters"}
NOVA_MODEL_BASE=https://api.openai.com/v1
NOVA_MODEL_KEY=your-provider-key
NOVA_MODEL=your-model-id
NOVA_MODEL_PROTOCOL=openai
# Optional models that the client is permitted to select, on the same provider.
# NOVA_BACKEND_MODELS=model-id-1,model-id-2
# NOVA_FALLBACK_MODEL=your-fallback-model-id

# Optional multi-provider / local router. Paths refer to the backend host.
# NOVA_ROUTER_FILE=deploy/model-router.example.json
# NOVA_ANTHROPIC_KEY=your-provider-key
# NOVA_OPENROUTER_KEY=your-provider-key
